# kernl.yaml: Kernl orchestrator configuration
#
# Copy this file to kernl.yaml and fill in your agents and repos.
# Run `kernl doctor` to validate.
#
# Kernl reads ./kernl.yaml by default, so a run from any other directory needs
# --config <path>. To drop the flag for good, export the path once:
#   export KERNL_CONFIG=/absolute/path/to/kernl.yaml
# Precedence: --config beats $KERNL_CONFIG beats ./kernl.yaml. Keep the paths
# below absolute; they are used as written, never resolved against the cwd.

settings:
  # Agents are the AI workers that Kernl dispatches to.
  # Each agent maps a label to a CLI command + model configuration.
  agents:
    opencode:
      # The CLI binary that starts the agent.
      command: opencode
      # Args passed after the command. opencode run --format json <prompt>
      # is the non-interactive invocation Kernl uses.
      args: ["run", "--format", "json"]
      # Agent type: claude, codex, gemini, or generic.
      type: claude
      # Vendor identifier (used for provider-specific dialect tuning).
      vendor: anthropic
      # Model ID passed to the agent CLI. Set this to the model you want
      # dispatched for tasks assigned to this agent.
      model: claude-sonnet-4-6
      # Human-readable label used in pool selection and logs.
      label: sonnet
      # Approval mode: auto (default) or prompt.
      #
      # auto dispatches the agent with its own permission checks bypassed: it
      # runs every tool unattended. prompt puts each tool call behind a
      # judgment gate - the agent blocks, the request shows up in
      # `kernl approval list` and in the GUI, and it resumes when a human
      # answers. Only claude and pi can be gated; any other CLI configured
      # with prompt is refused at dispatch rather than run unasked.
      approvalMode: auto
      # Optional: provider override (defaults to vendor).
      # provider: anthropic
      # Optional: agent name reported to bd (defaults to label).
      # agent_name: sonnet

  # Pools group weighted agents for dispatch selection.
  # When multiple agents are in a pool, Kernl picks one by weight,
  # respecting cross-agent exclusion rules.
  pools:
    # Per-bead worker stages (epic children use the "worker" profile).
    implementation:
      agents:
        - agentId: opencode
          weight: 1
    implementation_review:
      agents:
        - agentId: opencode
          weight: 1
    # Epic-level stages (the "epic" profile drives the epic bead after all
    # children reach awaiting_integration): merge children, review the merge,
    # then push + open the PR. Point integration_review at a reviewer-grade
    # model distinct from the integration model for independent eyes.
    integration:
      agents:
        - agentId: opencode
          weight: 1
    integration_review:
      agents:
        - agentId: opencode
          weight: 1
    shipment:
      agents:
        - agentId: opencode
          weight: 1

  # Default timeout for interactive (human-waiting) sessions, in minutes.
  defaults:
    interactiveSessionTimeoutMinutes: 30

# Registry maps repository paths to their storage backends.
# Each repo must declare its path and the memory manager type.
registry:
  repos:
    - path: /home/me/projects/example
      # Which tracker this repository's work lives in: br (beads_rust, SQLite
      # at .beads/beads.db) or beads (bd, Dolt at .beads/embeddeddolt). Leave it
      # unset and it is detected from what is inside .beads/ - both trackers use
      # that directory name, so the name alone decides nothing. Declaring it is
      # what lets `kernl doctor` tell you the CLI is missing before a run does.
      # A declaration is never overruled by what is on disk, so declaring a
      # tracker this repository was never initialized for is a real state:
      # doctor's `tracker-store` check is what names it, because every call
      # against such a repository fails - the sweep loop once per tick, and
      # the beads API on every request.
      memoryManager: br
      # What epic and bead branches are cut from. Leave it unset and the branch
      # is read out of the repository - what origin advertises as its HEAD,
      # falling back to whatever is checked out. Set it only when the
      # repository disagrees with that, never to state the obvious.
      # defaultBranch: main
      # What an agent runs before declaring a stage done. Unset, it is this
      # repository's own bin/ci, which must exist and be executable: a
      # repository that cannot say how it is verified gets no work dispatched
      # into it. Set it for anything else - "cargo test --all", "make check".
      # verifyCommand: bin/ci
      # How this repository says a pull request's PROSE is acceptable. It reads
      # the title and body on stdin and refuses with a non-zero exit. Shipment
      # runs it before opening the pull request, and kernl runs it again over
      # what was published, so a stage that skipped it does not read as success.
      # Unset means this repository declares no rule about prose, which
      # publishes as before: verifyCommand has a sane default to fall back on
      # (bin/ci), and a text gate has none worth inventing.
      # prTextCommand: bin/slop-guard --stdin 'PR text'
      # What this repository cannot cheaply take back. When an integration
      # review rejects, the orchestrator decides between another automatic
      # fix-up round and the operator on one criterion: how expensive the
      # change would be to undo. A branch that touched one of these paths goes
      # to the operator without anything being asked of a model.
      # A pattern ending in "/" claims that whole subtree; anything else is a
      # glob over the repository-relative path. Unset means this repository
      # declares none, which reads as "no mechanical reason to escalate" - it
      # never means "everything here is irreversible".
      # irreversibleSurfaces:
      #   - migrations/
      #   - db/schema.sql
      #   - openapi/*.yaml
      # What the Oracle reads to write a decision record's impact field: it
      # has no access to this repository otherwise, so this is the only way
      # it learns what the software is for. Listed files are sent VERBATIM
      # to whatever llm.agent/llm.endpoint points at - nothing leaves this
      # machine that was not named here. Unset defaults to README.md, then
      # ROADMAP.md; a repository that keeps no ROADMAP.md is not a failure,
      # it renders as "not found" in what the Oracle sees.
      # contextDocs:
      #   - README.md
      #   - ROADMAP.md
      # Shipment is the only stage that acts outside the machine: it pushes and
      # opens a pull request. Declare where that is allowed to land. With no
      # allowedRemotes the stage refuses to push at all - a repository that has
      # not said where it may publish does not publish. Run with --dry-run to
      # exercise everything up to shipment without configuring this.
      shipment:
        allowedRemotes:
          - git@github.com:me/example.git
        # The git remote to push to (default: origin). It is resolved to a URL,
        # checked against allowedRemotes, and named in the agent's prompt, so
        # nothing about the destination is left for the agent to work out.
        # remote: origin

# Orchestrator block controls the execution engine.
orchestrator:
  # Root directory for per-bead git worktrees (default: ~/.kernl/worktrees).
  # worktreeRoot: /home/me/.kernl/worktrees
  # Maximum beads that can run concurrently within a single epic wave
  # (default: 5).
  # maxConcurrentBeads: 5
  # Path to the SQLite run-state database (default: ~/.kernl/runstate.db).
  # runStatePath: /home/me/.kernl/runstate.db
  # How many fix-up rounds one epic may spend on integration review rejections
  # before the next one goes to you, however cheap it would be to undo
  # (default: 3). It is the hard stop behind the reversibility gate: a reviewer
  # can always find something, so without a bound "cheap to reverse" is a loop
  # that repairs itself all day while nobody finds out. Raise it for a
  # repository whose reviews converge slowly; lower it to be interrupted sooner.
  # fixupBudget: 3
  # How long a judgment gate waits for you before it is denied with a reason
  # (default: 30m). This is kernl's own policy: a gated agent waits
  # indefinitely on its side, so nothing else bounds the wait - and while it
  # waits it holds both its own process and one of maxConcurrentBeads' slots.
  # Only agents with approvalMode: prompt ever raise one.
  # approvalTimeout: 30m
  # The permission allowlist handed to a dispatched opencode agent. Unset,
  # kernl writes and uses ~/.kernl/opencode-config.json, which you can then
  # edit. Set it and the file must exist: a path that was named and is missing
  # is a mistake, not a request for the default.
  # opencodeConfigPath: /home/me/.config/kernl/opencode-config.json

# Server block for the HTTP API + monitoring GUI.
server:
  # Port for the REST + SSE API (default: 8080).
  port: 8080
  # Interface to bind (default: 127.0.0.1). The API has no authentication and
  # serves the vault, so loopback is the default on purpose. Set 0.0.0.0 only
  # when you mean it: a container, or a network you trust. The KERNL_HOST
  # environment variable overrides this.
  # host: 127.0.0.1

# Vault block enables the notes watcher and graph integration.
# When vault.root is empty (or the block is absent), vault watching is disabled.
# vault:
#   # Absolute path to the root directory of the notes vault.
#   # Must exist and be a directory when set.
#   root: /home/me/vault
#
#   # Quiet period after the last filesystem event before emitting a coalesced
#   # change event (milliseconds). Default: 300.
#   # coalesceWindowMs: 300
#
#   # Move/delete correlation window (milliseconds). A deletion is held for
#   # this long before being tombstoned; a matching create within the window
#   # is treated as a rename. Default: 1000.
#   # moveWindowMs: 1000
#
#   # Periodic full rescan interval (seconds). When >0, the watcher re-runs
#   # the cold-start diff at this interval as a safety net for missed events.
#   # Default: 0 (disabled).
#   # rescanIntervalSec: 0

# DA block declares the actor an implementer hands a fork over to, instead of
# deciding it alone and silently, when it meets a choice the bead, this
# repository's docs and existing precedent do not already determine. Named
# after the actor, not after the gate: `kernl da`, a separate interactive
# surface, spawns this same agent in this same place and reads these same
# two keys, so a block named after the gate would only invite a second
# declaration of it.
#
# Both keys unset (or the block absent) is a normal, supported state: the
# fork gate is off, and an implementer keeps deciding every fork alone, which
# is today's behavior. Setting exactly one of the two is an operator mistake
# and kernl refuses to start rather than run half-configured.
#
# da:
#   # A settings.agents key, exactly like llm.agent (used to reach the run
#   # report's Oracle): the command and the model come from that entry.
#   # There is deliberately no model key here.
#   #
#   # Only an entry whose OWN command is `claude` or `pi` can ever be
#   # consulted this way - measured: those are the only two dialects whose
#   # one-shot stdout is the answer with no framing around it, and both can
#   # be run with their tools restricted to read-only (see
#   # adapter.BuildConsultModeArgs). Every other command (including opencode,
#   # this file's own example agent above) is refused by name at startup.
#   agent: claude
#   # The operator's OWN system repository - where their notes, telos and
#   # recorded preferences already live - never the target repository under
#   # review. This is the deliberate OPPOSITE of the Oracle: the Oracle runs
#   # with no tools and no working directory at all, because it must never
#   # read a repository it is only supposed to describe; the DA is worthless
#   # unless it can reach what the operator actually wrote down. Neither is a
#   # precedent for the other. Always an absolute path, never committed as a
#   # real one - replace this placeholder with your own.
#   workDir: /absolute/path/to/your/notes-and-telos-repo

# Retrieval tuning for the link-suggestion path.
#
# DO NOT CHANGE THESE PERMANENTLY WITHOUT RE-MEASURING. Every value here was
# picked by running an experiment, and a value picked any other way is a guess
# wearing a measured value's clothes. Sweeping is free and is what the knob is
# for - `kernl plan --for-linking --link-budget <n> "<a note's text>"` overrides
# it for one call, touching neither this file nor a running server - but a change
# that STAYS needs a number behind it, and the comment on
# config.PlanningConfig.LinkBudget has to be replaced with the numbers that
# justified it.
#
# planning:
#   # Slots reserved for notes reached by an EDGE from a content hit rather than
#   # by matching the text. The reservation comes OUT OF the candidate budget,
#   # never on top of it, and only for the slots the walk actually fills.
#   #
#   # Absent means the measured default, 3. An explicit 0 turns the expansion
#   # off, which is why the key distinguishes "absent" from "zero" at all.
#   #
#   # Measured 2026-08-20 as link recall, over the links somebody made by reading
#   # (a frozen cohort of 108 notes) and over the 586 a retroactive link pass
#   # produced. The right-hand figure is the share of notes offered not one of
#   # the links they actually have - the pocket the expansion exists to close,
#   # because content matching cannot reach a neighbour through an edge:
#   #
#   #   budget   cohort              live
#   #   0        0.720 · 18% none    0.591 · 18% none
#   #   2        0.800 ·  5%         0.739 ·  0%
#   #   3        0.827 ·  5%         0.761 ·  0%
#   #   4        0.867 ·  2%         0.750 ·  2%
#   #
#   # The two curves disagree at 4 and 3 is the only point that improves on both
#   # without turning on either. Expect it to age: the cohort curve says the
#   # right budget GROWS as the graph densifies, which is a reason to re-measure
#   # and not a reason to raise it on a hunch.
#   linkBudget: 3
